# Copy to .env.local for local development. Never commit real credentials.
# Business data connection. Keep this role least-privileged for tenant tables.
DATABASE_URL=postgresql://APP_USER:PASSWORD@localhost:5432/ai_workforce
DATABASE_SSL=false

# Better Auth uses a separate database role/connection so auth tables do not
# require broad privileges on business data.
AUTH_DATABASE_URL=postgresql://AUTH_USER:PASSWORD@localhost:5432/ai_workforce
AUTH_DATABASE_SSL=false
BETTER_AUTH_SECRET=replace-with-at-least-32-random-bytes
BETTER_AUTH_URL=http://localhost:3000
APP_ORIGIN=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Internal worker API. Generate at least 32 random bytes; never expose to browsers.
WORKER_SHARED_SECRET=replace-with-at-least-32-random-bytes

# OmniRoute integration is intentionally not active in Phase 2.
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_API_KEY=
