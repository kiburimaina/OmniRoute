# Copy to .env.local for local development. Never commit real credentials.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/ai_workforce
DATABASE_SSL=false

# HS256 JWT session contract. The token issuer must sign with this secret,
# issuer, and audience; subject (sub) must be the authenticated user's UUID.
AUTH_SECRET=replace-with-at-least-32-random-bytes
AUTH_ISSUER=ai-workforce
AUTH_AUDIENCE=ai-workforce-app
# Exact public origin used to validate cookie-authenticated POST requests.
APP_ORIGIN=http://localhost:3000

# OmniRoute integration is intentionally not active in Phase 2.
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_API_KEY=
